#!/bin/sh
# AgentSuite's shared pre-push hook (git config core.hooksPath ../AgentSuite/githooks, once per checkout).
# Refuses a push while any GitHub workflow in the repo breaks the quiet-CI contract (AgentSuite/ci.md): a run that can go red
# or be cancelled mails whoever triggered it. Then runs the repo's own .git/hooks/pre-push, if it has one.
here=$(cd "$(dirname "$0")/.." && pwd)
root=$(git rev-parse --show-toplevel)
# The first interpreter that really runs Python 3.8+. On Windows, python3/python can be the Microsoft Store shortcuts,
# which exist on PATH but only print an install hint, so each candidate is tried rather than just found; `py -3` is the
# Windows launcher.
py=
for candidate in python3 python "py -3"; do
  # shellcheck disable=SC2086
  if $candidate -c 'import sys; sys.exit(sys.version_info < (3, 8))' >/dev/null 2>&1; then
    py=$candidate
    break
  fi
done
if [ -z "$py" ]; then
  echo "pre-push: Python 3.8+ is needed to check the workflows (AgentSuite/ci.md); refusing" >&2
  exit 1
fi
# shellcheck disable=SC2086
if ! $py "$here/tools/check-workflows.py" "$root"; then
  echo "pre-push: refused - fix the above (AgentSuite/ci.md) so no run can mail a failure" >&2
  exit 1
fi
own="$(git rev-parse --git-common-dir)/hooks/pre-push"
[ -x "$own" ] && exec "$own" "$@"
exit 0
